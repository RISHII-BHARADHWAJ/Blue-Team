# Protect internal source, migrations and raw telemetry when Apache serves the repository root.
# Requires AllowOverride FileInfo Options AuthConfig (Dockerfile enables AllowOverride All).
Options -Indexes

<FilesMatch "\.(?:log|sql|sh|env|bak|old|ini|conf)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:Dockerfile|docker-compose\.yml|render\.yaml|README\.md|\.dockerignore)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:includes|database|deploy|docs|tests)(?:/|$) - [F,L,NC]

# Never serve Git metadata, dotfiles, editor backups, or alternate PHP source.
RewriteRule (^|/)\. - [F,L]
<FilesMatch "(?i)(?:\.(?:swp|swo|orig|dist|save|inc|phtml|php[0-9]+)|~)$">
    Require all denied
</FilesMatch>
LimitRequestBody 1048576

<FilesMatch "^(?:_audit_cmd|generate|merge_logs)\.php$">
    Require all denied
</FilesMatch>
